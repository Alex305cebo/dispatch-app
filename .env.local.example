# Copy to .env.local and fill in. Never commit .env.local.

# Free Neon project → Connection Details → connection string.
# Same value goes into Vercel project env vars.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Public base URL — the address the extension's QR code points at.
# Local testing over Wi-Fi: http://192.168.1.6:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
