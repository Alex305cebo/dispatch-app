# Copy to .env.local and fill in. Never commit .env.local.

# Free Neon project → Connection Details → connection string.
# Same value goes into Vercel project env vars.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Public base URL — the address the extension's QR code points at.
# Local testing over Wi-Fi: http://192.168.1.6:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ZigZag ELD — vendor-issued credentials (GPS only; HOS not granted as of 2026-07-23).
# Contract: docs/zigzag-api-findings.md. The poller does nothing unless all three are set.
# NEVER commit the real password — set it in .env.local locally and in the host's
# environment variables in production.
ELD_USERNAME=
ELD_PASSWORD=
ELD_COMPANY_ID=
# Optional override; defaults to https://eldapi.zigzageld.com
# ELD_API_URL=
