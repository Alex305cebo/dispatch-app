# Скопировать в .env.local и заполнить. .env.local никогда не коммитить.
#
# На хостинге эти же значения задаются в панели: hPanel → Environment variables,
# они действуют на один сайт. Порядок такой же, как здесь.
#
# Против каждой переменной написано, ЧТО СЛОМАЕТСЯ без неё. Пустая строка — не
# ошибка: почти всё приложение спроектировано так, чтобы без ключа отключалась
# одна возможность, а не падала страница.


# ─── Обязательно ────────────────────────────────────────────────────────────
# Без этого не поднимется ничего.

# Строка подключения к базе. Neon → проект → Connection Details → возьмите
# DIRECT-строку (не pooled): schema.sql её накатывает, пулер на DDL спотыкается.
# Схема ставится командой:
#   npm run db:init -- "<эта строка>" --co-name="ACME Trucking" --co-mcdot="MC 123456"
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Общий секрет для служебных маршрутов: /api/eld-poll, /api/tg-poll и
# /api/health?ready=. Любая длинная случайная строка.
# БЕЗ НЕГО: опрос GPS отвечает 401 всем подряд, то есть отслеживание молча
# никогда не обновляется, и клиент решает, что продукт не работает.
CRON_SECRET=


# ─── Карты: только эти две вшиваются в сборку ───────────────────────────────
# NEXT_PUBLIC_* попадают в клиентский бандл на этапе сборки, поэтому их нельзя
# держать в базе клиента и нельзя ввести в интерфейсе — они задаются здесь и
# остаются ВАШИМИ во всех установках. Оба тарифа бесплатные и щедрые.
# БЕЗ НИХ: карта работает, но на простых тайлах OpenStreetMap — без нормальных
# щитов автомагистралей и без спутника.

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=


# ─── Ключи, которые обычно вводит сам клиент ────────────────────────────────
# Эти три задаются в приложении: Админ → Ключи. Значение из настроек побеждает,
# а переменная остаётся запасным ходом для локальной разработки и для вашей
# собственной установки. В установке клиента их здесь заполнять не нужно.

# Google AI Studio. БЕЗ НЕГО: не читаются рейт-коны и документы, /api/ratecon
# отдаёт 503 no_key, разбор просто не предлагается.
GEMINI_API_KEY=

# FMCSA QCMobile (mobile.fmcsa.dot.gov/QCDevsite, бесплатный, выдаётся сразу).
# БЕЗ НЕГО: не проверяется авторитетность брокера по MC и DOT.
FMCSA_WEBKEY=

# HERE platform → Access Manager → Apps → Create API key.
# БЕЗ НЕГО: раздел «Толлы» честно говорит, что считать нечем.
HERE_API_KEY=


# ─── ELD: только если у клиента ZigZag ──────────────────────────────────────
# Поллер молчит, пока не заданы все три. Пароль в репозиторий не коммитить
# никогда — только в .env.local и в переменные хостинга.
# БЕЗ НИХ: GPS не приходит, отслеживание и автосмена статусов не работают.
# Контракт вендора разобран в docs/zigzag-api-findings.md.

ELD_USERNAME=
ELD_PASSWORD=
ELD_COMPANY_ID=

# Необязательные подмены адресов вендора. По умолчанию eldapi.zigzageld.com и
# набор запасных баз для ссылок «Live Share».
# ELD_API_URL=
# ELD_SHARE_URL=


# ─── Необязательное: без них работает, но хуже ──────────────────────────────

# eia.gov — розничная цена дизеля по стране, недельная.
# БЕЗ НЕГО: цена топлива не подтягивается сама, её вводят руками в настройках трака.
EIA_API_KEY=

# openrouteservice.org, профиль driving-hgv — маршрут по дорогам, разрешённым
# для трака. БЕЗ НЕГО: мили считает бесплатный OSRM, который ведёт легковую
# машину, — расхождение на трак-специфичных участках.
ORS_API_KEY=

# Общий секрет для расширения DispatchPro: оно POST-ит снимок ELD в /api/fleet.
# БЕЗ НЕГО: маршрут закрыт наглухо, расширение писать не может.
FLEET_INGEST_TOKEN=


# ─── Удалено намеренно ──────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL здесь был, но его не читает ни одна строка кода — проверено
# поиском по app/, lib/, components/ и middleware. Комментарий рядом с ним
# обещал «адрес, на который указывает QR расширения», и это давно неправда.
# При переносе на новый домен менять в коде нечего: все ссылки относительные,
# кука сессии без атрибута domain, редиректы делаются rewrite'ом.
